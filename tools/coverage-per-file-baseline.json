{
  "policy": {
    "floor": 95,
    "dimensions": [
      "statements",
      "branches",
      "functions",
      "lines"
    ],
    "note": "Counts, not rates: the gate compares covered/total by cross-multiplication so no comparison goes through a float. Regenerate with tools/coverage-per-file.mjs --write-baseline, which refuses to lower a recorded rate or admit new debt without being told to."
  },
  "exempt": {
    "cortex-ai/src/index.ts": {
      "kind": "nothing-to-execute",
      "reason": "The Node entry point, and it is `export ... from` only. A re-export statement produces no counter under the v8 provider, so the file reports 0/0 while every module it names is measured on its own entry."
    },
    "cortex-ai/src/local/index.ts": {
      "kind": "nothing-to-execute",
      "reason": "The `./local` entry point: re-exports the ONNX-backed embedder and nothing else. It exists as a separate entry so a Node service does not link the runtime, which `tools/entry-guard.mjs` asserts over the import closure."
    },
    "cortex-ai/src/web/index.ts": {
      "kind": "nothing-to-execute",
      "reason": "The `./web` entry point: re-exports the browser's built-in model. Re-exports only, so there is nothing to execute."
    },
    "cortex-core/src/index.ts": {
      "kind": "nothing-to-execute",
      "reason": "The package root: `export ... from` statements and no runtime code of its own. Every module it names has its own measured entry in this baseline; a barrel has nothing to execute."
    },
    "cortex-core/src/interfaces/embedding.ts": {
      "kind": "nothing-to-execute",
      "reason": "Declaration-only: `EmbeddingModel` and its option types. No runtime export, so the instrumenter records no statement."
    },
    "cortex-core/src/interfaces/llm.ts": {
      "kind": "nothing-to-execute",
      "reason": "Declaration-only: the `LLM` contract, `CompleteOptions` and `JsonSchema`. No runtime export."
    },
    "cortex-core/src/interfaces/storage.ts": {
      "kind": "nothing-to-execute",
      "reason": "Declaration-only: `Storage`, `StorageTransaction`, `PutOptions` and `QueryPredicate`. No runtime export."
    },
    "cortex-core/src/interfaces/vector.ts": {
      "kind": "nothing-to-execute",
      "reason": "Declaration-only: `VectorIndex`, `VectorHit` and `VectorFilter`. No runtime export."
    },
    "cortex-eval/src/index.ts": {
      "kind": "nothing-to-execute",
      "reason": "The package root: re-exports only, so no counter of its own. The harness modules behind it are each measured."
    },
    "cortex-eval/src/types.ts": {
      "kind": "not-instrumented",
      "reason": "Excluded in `vitest.config.ts` and declaration-only in fact: every export is a `type` or an `interface`, and the file's own header records that a runtime export would void the exclusion. Absent from the report rather than uncovered."
    },
    "cortex-memory/src/index.ts": {
      "kind": "nothing-to-execute",
      "reason": "The package root: re-exports only. `index.test.ts` imports it to prove the entry surface resolves, which is a different claim from a counter moving -- and this record is what stops the 0/0 from being read as 'covered by that test'."
    },
    "cortex-storage/src/browser/idb.ts": {
      "kind": "not-instrumented",
      "reason": "Needs `IndexedDB`, which Node does not have. Excluded from the Node run and covered by `test/browser/probe.mjs`, which runs the built package in a real Chromium twice across a restart and asserts named checks -- a measurement this report cannot hold."
    },
    "cortex-storage/src/browser/opfs-worker.ts": {
      "kind": "not-instrumented",
      "reason": "Runs inside a `Worker`, which the Node run has no honest stand-in for. Covered by the same Chromium probe as `idb.ts`."
    },
    "cortex-storage/src/browser/opfs.ts": {
      "kind": "not-instrumented",
      "reason": "Needs OPFS access handles, which Node does not have; a shim would assert the shim. Covered by the same Chromium probe as `idb.ts`."
    },
    "cortex-storage/src/index.ts": {
      "kind": "nothing-to-execute",
      "reason": "The root exports nothing on purpose (`export {}`), so importing the package root cannot link a native addon or a socket client; each backend is its own subpath. Zero statements by design, not a gap."
    }
  },
