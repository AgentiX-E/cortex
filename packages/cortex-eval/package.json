{
  "name": "@agentix-e/cortex-eval",
  "version": "0.1.0",
  "description": "cortex-eval — scientific evaluation harness for agent memory systems (metrics, significance testing, ablation)",
  "license": "MIT",
  "author": "Lambertyan",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "lint": "eslint src/ bench/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench": "node --import tsx bench/run.ts",
    "clean": "rm -rf dist *.tsbuildinfo coverage"
  },
  "dependencies": {
    "@agentix-e/cortex-core": "workspace:*",
    "@agentix-e/cortex-llm": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  }
}
