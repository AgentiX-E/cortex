{
  "name": "@agentix-e/cortex-eval",
  "version": "0.1.0",
  "description": "cortex-eval — scientific evaluation harness for agent memory systems (metrics, significance testing, ablation)",
  "license": "MIT",
  "author": "Lambertyan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentiX-E/cortex.git",
    "directory": "packages/cortex-eval"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.build.tsbuildinfo && tsc -p tsconfig.build.json",
    "test": "vitest run --coverage",
    "lint": "eslint src/ bench/",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.bench.json",
    "bench": "node --import tsx bench/run.ts",
    "probe:cache-credit": "node --import tsx bench/probe-cache-credit.ts",
    "clean": "rm -rf dist *.tsbuildinfo coverage"
  },
  "dependencies": {
    "@agentix-e/cortex-ai": "workspace:*",
    "@agentix-e/cortex-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.0.0",
    "fast-check": "^3.23.0",
    "tsx": "^4.23.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  }
}
