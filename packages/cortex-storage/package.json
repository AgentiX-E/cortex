{
  "name": "@agentix-e/cortex-storage",
  "version": "0.1.0",
  "description": "cortex-storage \u2014 storage backends for Cortex, one subpath per backend: SQLite and PostgreSQL in Node, OPFS and IndexedDB in the browser",
  "license": "MIT",
  "author": "Lambertyan",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/storage/sqlite.d.ts",
      "import": "./dist/storage/sqlite.js"
    },
    "./pg": {
      "types": "./dist/storage/pg.d.ts",
      "import": "./dist/storage/pg.js"
    },
    "./opfs": {
      "types": "./dist/browser/opfs.d.ts",
      "import": "./dist/browser/opfs.js"
    },
    "./opfs/worker": {
      "types": "./dist/browser/opfs-worker.d.ts",
      "import": "./dist/browser/opfs-worker.js"
    },
    "./idb": {
      "types": "./dist/browser/idb.d.ts",
      "import": "./dist/browser/idb.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "guard": "node ../../tools/entry-guard.mjs --package .",
    "clean": "rm -rf dist *.tsbuildinfo coverage",
    "test:browser": "node test/browser/probe.mjs && node test/browser/bundle-probe.mjs",
    "test:browser:firefox": "node test/browser/probe-firefox.mjs"
  },
  "dependencies": {
    "@agentix-e/cortex-core": "workspace:*"
  },
  "peerDependencies": {
    "better-sqlite3": "^11.0.0",
    "pg": "^8.22.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "@types/better-sqlite3": "^7.6.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^2.0.0",
    "better-sqlite3": "^11.0.0",
    "eslint": "^9.0.0",
    "pg": "^8.22.0",
    "pg-mem": "^3.0.14",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  }
}
