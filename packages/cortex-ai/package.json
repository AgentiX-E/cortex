{
  "name": "@agentix-e/cortex-ai",
  "version": "0.1.0",
  "description": "cortex-ai \u2014 provider-agnostic model adapters (remote OpenAI-compatible, local transformers.js, browser built-in) and `./agent`, the retrieval loop the reader drives",
  "license": "MIT",
  "author": "Lambertyan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentiX-E/cortex.git",
    "directory": "packages/cortex-ai"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./local": {
      "types": "./dist/local/index.d.ts",
      "import": "./dist/local/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.build.tsbuildinfo && tsc -p tsconfig.build.json",
    "test": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo coverage",
    "test:parity": "node test/parity/run.mjs"
  },
  "dependencies": {
    "@agentix-e/cortex-core": "workspace:*"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.3.1"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  }
}
