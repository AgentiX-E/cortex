{
  "name": "@agentix-e/cortex",
  "version": "0.0.0",
  "private": true,
  "description": "Cortex — a value-driven cognitive memory layer for AI agents, for Node.js and the browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentiX-E/cortex.git"
  },
  "license": "MIT",
  "author": "Lambertyan",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --check '**/*.ts'",
    "format:fix": "prettier --write '**/*.ts'",
    "clean": "pnpm -r clean",
    "census": "node tools/export-census.mjs",
    "census:check": "node tools/export-census.mjs --check",
    "check": "pnpm build && pnpm test:tools && pnpm guard:entry && pnpm guard:bundle && pnpm guard:browser && pnpm lint && pnpm typecheck && pnpm census:check && pnpm test && pnpm acceptance:check && pnpm docs:crosscheck && pnpm format",
    "test:tools": "python3 -m pytest tools/__tests__ -q && python3 tools/check-shell-interpolation.py .",
    "classify:raw": "python3 tools/classify-raw-outputs.py",
    "guard:diagnose": "python3 tools/diagnose-bad-substitution.py",
    "guard:sh": "python3 tools/check-shell-interpolation.py --fragment -",
    "guard:shim": "python3 -m pytest tools/__tests__/test_shim_guard.py -q",
    "run:program": "python3 tools/run-program.py",
    "exec:python": "python3 tools/exec-python.py",
    "probe:stdin": "python3 tools/probe.py",
    "probe": "python3 tools/run-program.py --lang mjs --keep probe/latest.mjs -",
    "guard:entry": "node tools/entry-guard.mjs --self-test",
    "guard:bundle": "node tools/bundle-guard.mjs --self-test && node tools/bundle-guard.mjs",
    "guard:browser": "node tools/browser-reading-check.mjs --committed packages/cortex-storage/test/browser/last-run.json --fresh packages/cortex-storage/test/browser/last-run-firefox.json",
    "test:browser": "pnpm --filter @agentix-e/cortex-storage test:browser",
    "acceptance": "node tools/acceptance-check.mjs",
    "acceptance:check": "node tools/acceptance-check.mjs",
    "docs:crosscheck": "node tools/docs-crosscheck.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "esbuild": "0.28.2",
    "prettier": "^3.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@9.15.0"
}
