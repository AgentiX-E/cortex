{
  "name": "@agentix-e/cortex",
  "version": "0.0.0",
  "private": true,
  "description": "Cortex — a value-driven cognitive memory layer for AI agents, for Node.js and the browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentiX-E/cortex.git"
  },
  "license": "MIT",
  "author": "Lambertyan",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --check '**/*.ts'",
    "format:fix": "prettier --write '**/*.ts'",
    "clean": "pnpm -r clean",
    "census": "node tools/export-census.mjs",
    "census:check": "node tools/export-census.mjs --check",
    "registration:check": "python3 tools/arm-config-record.py --check",
    "token:check": "python3 tools/token-basis.py --check",
    "coverage:gate": "node tools/coverage-per-file.mjs",
    "reuse:census": "node tools/embedding-reuse-census.mjs",
    "coverage:baseline": "node tools/coverage-per-file.mjs --write-baseline",
    "check": "pnpm build && pnpm test:tools && pnpm guard:ci && pnpm guard:entry && pnpm guard:bundle && pnpm guard:install && pnpm guard:assemble && pnpm guard:browser && pnpm guard:triage && pnpm guard:gold-band && pnpm guard:turn-width && pnpm guard:scoped-spend && pnpm guard:prompt-identity && pnpm guard:prereg && pnpm guard:paired-delta && pnpm guard:exclusion-census && pnpm guard:membership-reach && pnpm guard:room-census && pnpm guard:failure-classes && pnpm guard:queue-floor && pnpm guard:queue-price && pnpm parity:multi-query && pnpm lint && pnpm typecheck && pnpm manual:check && pnpm census:check && pnpm ledger:check && pnpm registration:check && pnpm guard:arm-config && pnpm token:check && pnpm test && pnpm coverage:gate && pnpm reuse:census && pnpm erasure:census && pnpm corpus:census && pnpm readings:check && pnpm acceptance:check && pnpm docs:crosscheck && pnpm format",
    "test:tools": "python3 -m pytest tools/__tests__ -q && python3 tools/check-shell-interpolation.py .",
    "classify:raw": "python3 tools/classify-raw-outputs.py",
    "guard:diagnose": "python3 tools/diagnose-bad-substitution.py",
    "guard:sh": "python3 tools/check-shell-interpolation.py --fragment -",
    "guard:shim": "python3 -m pytest tools/__tests__/test_shim_guard.py -q",
    "run:program": "python3 tools/run-program.py",
    "exec:python": "python3 tools/exec-python.py",
    "probe:stdin": "python3 tools/probe.py",
    "probe": "python3 tools/run-program.py --lang mjs --keep probe/latest.mjs -",
    "guard:entry": "node tools/entry-guard.mjs --self-test",
    "guard:bundle": "node tools/bundle-guard.mjs --self-test && node tools/bundle-guard.mjs",
    "guard:install": "node tools/install-smoke.mjs --self-test && node tools/install-smoke.mjs",
    "guard:assemble": "node tools/assemble-coverage.mjs --self-test && node tools/assemble-coverage.mjs",
    "guard:browser": "node tools/browser-reading-check.mjs --committed packages/cortex-storage/test/browser/last-run.json --fresh packages/cortex-storage/test/browser/last-run-firefox.json",
    "guard:triage": "node tools/triage-parity.mjs",
    "census:gold-band": "node tools/gold-band-census.mjs",
    "guard:gold-band": "node tools/gold-band-census.mjs --self-test",
    "guard:turn-width": "node tools/turn-width.mjs --self-test",
    "guard:scoped-spend": "node tools/scoped-spend.mjs --self-test",
    "guard:prompt-identity": "node tools/prompt-identity.mjs --self-test",
    "guard:prereg": "node tools/prereg-status.mjs --self-test && node tools/prereg-status.mjs --check",
    "guard:paired-delta": "node tools/paired-delta-census.mjs --self-test",
    "guard:exclusion-census": "node tools/exclusion-census.mjs --self-test",
    "guard:membership-reach": "node tools/membership-reach.mjs --self-test",
    "guard:room-census": "node tools/room-census.mjs --self-test",
    "guard:failure-classes": "node tools/failure-classes.mjs --self-test",
    "guard:queue-floor": "node tools/queue-floor.mjs --self-test",
    "guard:queue-price": "node tools/queue-price.mjs --self-test",
    "test:browser": "pnpm --filter @agentix-e/cortex-storage test:browser && pnpm --filter @agentix-e/cortex-memory test:browser",
    "acceptance": "node tools/acceptance-check.mjs",
    "acceptance:check": "node tools/acceptance-check.mjs",
    "docs:crosscheck": "node tools/docs-crosscheck.mjs",
    "manual:check": "node tools/manual-examples.mjs",
    "guard:ci": "python3 tools/ci-gate-audit.py",
    "test:pg": "pnpm --filter @agentix-e/cortex-storage test:pg",
    "erasure:census": "node tools/erasure-census.mjs",
    "corpus:census": "node tools/corpus-read-census.mjs",
    "corpus:census:write": "node tools/corpus-read-census.mjs --out ../cortex-docs/evidence/corpus/read-cost.json",
    "readings:check": "node tools/readings-census.mjs --check",
    "readings:write": "node tools/readings-census.mjs --write",
    "ledger:check": "node tools/product-capability-ledger.mjs --check",
    "ledger:write": "node tools/product-capability-ledger.mjs --write",
    "parity:multi-query": "node tools/multi-query-parity.mjs",
    "guard:arm-config": "node tools/arm-config-guard.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "0.28.2",
    "prettier": "^3.3.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "overrides": {
      "minimatch": "^11.0.1"
    }
  },
  "packageManager": "pnpm@9.15.0"
}
